# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The public URL where this app is hosted.
APP_URL=""

# Cloudflare R2 Media Storage Configuration
# SECURITY: fill these in your host's environment-variable panel (Netlify / Cloud Run).
# NEVER put real credentials in this file — it is committed to the repository.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Firebase Web API key (public project identifier, used for server-side token verification)
FIREBASE_WEB_API_KEY=""

# Translation Providers Configuration (Cloudflare AI & DeepL AI)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
DEEPL_API_KEY=""

# Google OAuth Configuration (optional, server-side token refresh)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
